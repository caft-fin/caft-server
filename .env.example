# ──────────────────────────────────────
# CAFT Financial Server — Environment
# ──────────────────────────────────────

# Server
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Database (PostgreSQL via Docker)
DATABASE_URL="postgresql://postgres:caft_dev_2024@localhost:5432/caft_financial?schema=public"

# Redis (via Docker)
REDIS_URL="redis://localhost:6379"

# JWT Secrets
JWT_ACCESS_SECRET="your-access-token-secret-change-me"
JWT_REFRESH_SECRET="your-refresh-token-secret-change-me"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# Razorpay (Test Mode)
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="your-razorpay-key-secret"
RAZORPAY_WEBHOOK_SECRET="your-razorpay-webhook-secret"

# AWS SES (Hyderabad)
AWS_REGION="ap-south-2"
AWS_ACCESS_KEY_ID="your-aws-access-key-id"
AWS_SECRET_ACCESS_KEY="your-aws-secret-access-key"
SES_FROM_EMAIL="noreply@caft.financial"
SES_FROM_NAME="CAFT Financial"

# App
APP_NAME="CAFT Financial"
APP_URL="http://localhost:3000"
