// ─────────────────────────────────────────────────────────
// CAFT Financial — Prisma Schema
// ─────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ────────────────────────────────────────────────

enum Role {
  USER
  ADMIN
}

enum PlanType {
  FREE
  PAID
}

enum ItemCategory {
  SUBSCRIPTION
  DIGITAL_PRODUCT
  PHYSICAL_PRODUCT
  SERVICE
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SubscriptionStatus {
  CREATED
  AUTHENTICATED
  ACTIVE
  PENDING
  HALTED
  CANCELLED
  COMPLETED
  EXPIRED
}

enum PaymentStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  REFUNDED
  FAILED
}

enum BillingCycle {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
  QUARTERLY
  HALFYEARLY
  ANNUALLY
  ONETIME
}

enum PurchaseStatus {
  CREATED
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PricingMode {
  PERCENT
  FLAT
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  PAUSED
  COMPLETED
  FAILED
}

enum EmailDeliveryStatus {
  PENDING
  SENT
  DELIVERED
  BOUNCED
  COMPLAINED
  FAILED
}

enum VideoEventType {
  PLAY
  PAUSE
  SEEK
  FAST_FORWARD
  REWIND
  SKIP_SECTION
  COMPLETE
  EXIT
  REPLAY
}

enum CourseAccessType {
  FREE
  PREVIEW
  FULL
}

enum BadgeType {
  COURSE_COMPLETE
  FAST_LEARNER
  STREAK_7_DAY
  FIRST_COURSE
  TOP_REVIEWER
}

// ── User ─────────────────────────────────────────────────

model User {
  id               String  @id @default(uuid())
  email            String  @unique
  name             String
  phone            String?
  avatarUrl        String?
  role             Role    @default(USER)
  passwordHash     String? // Only for admin users
  isActive         Boolean @default(true)
  isEmailVerified  Boolean @default(false)
  kycVerified      Boolean @default(false)
  twoFactorEnabled Boolean @default(false)
  biometricEnabled Boolean @default(false)
  isSuperAdmin     Boolean @default(false) // Only true for seed-created admin
  referralCode     String? @unique
  googleId         String? @unique // Google OAuth subject ID
  referredById     String?

  // Location & visit tracking (populated on login)
  lastIpAddress    String?
  lastCity         String?
  lastState        String?
  lastPincode      String?
  lastCountry      String?
  totalVisits      Int     @default(0)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?

  // Relations
  referredBy         User?                   @relation("UserReferrals", fields: [referredById], references: [id])
  referrals          User[]                  @relation("UserReferrals")
  otpTokens          OtpToken[]
  refreshTokens      RefreshToken[]
  subscriptions      Subscription[]
  purchases          Purchase[]
  payments           Payment[]
  transactions       Transaction[]
  linkedAccounts     LinkedAccount[]
  notificationPrefs  NotificationPreference?
  campaignRecipients EmailRecipient[]
  auditLogs          AuditLog[]
  reviews            Review[]

  // Course platform relations
  courseEnrollments  CourseEnrollment[]
  videoProgress     VideoProgress[]
  videoEvents       VideoEvent[]
  courseCompletions  CourseCompletion[]
  coursePayments    CoursePayment[]
  courseBadges      Badge[]
  courseFeedback    CourseFeedback[]

  @@index([email])
  @@index([role])
  @@index([isActive])
  @@map("users")
}

// ── Auth ─────────────────────────────────────────────────

model OtpToken {
  id        String    @id @default(uuid())
  userId    String
  code      String
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("otp_tokens")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

// ── Subscription Plans ───────────────────────────────────

model Plan {
  id               String   @id @default(uuid())
  name             String
  slug             String   @unique
  description      String
  planType         PlanType     @default(PAID)
  itemCategory     ItemCategory @default(SUBSCRIPTION)
  currency         String       @default("INR")
  bannerBadge      String?      // e.g., "Most Popular", "Best Value", "New"
  images           String[]     // Array of image URLs
  isPopular        Boolean      @default(false)
  isActive         Boolean      @default(true)
  sortOrder        Int          @default(0)
  stockLimit       Int?         // Null means unlimited
  stockSold        Int          @default(0) // Track units sold for physical products
  taxPercentage    Float?       // e.g., 18.0 for 18% GST (legacy, use category pricing)

  // One-time purchase (lifetime)
  isOneTime        Boolean  @default(false)
  oneTimePrice     Int?     // Amount in paise for one-time purchase

  // Free trial
  freeTrialEnabled Boolean  @default(false)
  freeTrialDays    Int?     // Number of trial days

  // Discount
  discountPercent  Float?   // 0.0 to 100.0
  discountLabel    String?  // e.g., "Launch Offer", "Limited Time"

  // Product-level pricing overrides (null = inherit from CategoryPricing)
  gstMode            PricingMode?
  gstValue           Float?
  gatewayChargeMode  PricingMode?
  gatewayChargeValue Float?
  serviceFeeMode     PricingMode?
  serviceFeeValue    Float?
  processingFeeMode  PricingMode?
  processingFeeValue Float?
  platformChargeMode PricingMode?
  platformChargeValue Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  features      PlanFeature[]
  pricing       PlanPricing[]
  subscriptions Subscription[]
  purchases     Purchase[]
  courses       Course[]       // Courses gated by this plan
  bundlePlans   BundlePlan[]
  reviews       Review[]

  @@index([isActive])
  @@index([slug])
  @@index([planType])
  @@index([itemCategory])
  @@map("plans")
}

model PlanFeature {
  id        String  @id @default(uuid())
  planId    String
  name      String
  included  Boolean @default(true)
  value     String? // e.g., "10", "Unlimited", "Monthly"
  icon      String? // Lucide icon name, e.g., "check-circle", "zap", "shield"
  sortOrder Int     @default(0)

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@map("plan_features")
}

model PlanPricing {
  id             String       @id @default(uuid())
  planId         String
  billingCycle   BillingCycle
  price          Int          // Amount in paise (smallest currency unit)
  razorpayPlanId String?      // Razorpay plan ID (null for FREE or ONETIME)
  isActive       Boolean      @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, billingCycle])
  @@index([planId])
  @@map("plan_pricing")
}

// ── Plan Bundles ─────────────────────────────────────────

model PlanBundle {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  description String?
  price       Int     // Custom bundle price in paise
  currency    String  @default("INR")
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plans         BundlePlan[]
  subscriptions Subscription[]

  @@index([isActive])
  @@map("plan_bundles")
}

model BundlePlan {
  id       String @id @default(uuid())
  bundleId String
  planId   String

  bundle PlanBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  plan   Plan      @relation(fields: [planId], references: [id])

  @@unique([bundleId, planId])
  @@index([bundleId])
  @@index([planId])
  @@map("bundle_plans")
}

// ── Subscriptions ────────────────────────────────────────

model Subscription {
  id                     String             @id @default(uuid())
  userId                 String
  planId                 String
  razorpaySubscriptionId String?            @unique
  razorpayCustomerId     String?
  status                 SubscriptionStatus @default(CREATED)
  billingCycle           BillingCycle       @default(MONTHLY)
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  cancelledAt            DateTime?
  cancelReason           String?

  // Extended fields
  isOneTime              Boolean            @default(false)
  bundleId               String?            // If purchased as part of a bundle
  discountApplied        Float?             // Discount % at time of purchase
  trialEndsAt            DateTime?          // When the free trial ends

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User        @relation(fields: [userId], references: [id])
  plan     Plan        @relation(fields: [planId], references: [id])
  bundle   PlanBundle? @relation(fields: [bundleId], references: [id])
  payments Payment[]

  @@index([userId])
  @@index([planId])
  @@index([status])
  @@index([razorpaySubscriptionId])
  @@index([bundleId])
  @@map("subscriptions")
}

// ── Purchases (One-time & Physical) ─────────────────────

model Purchase {
  id                String         @id @default(uuid())
  userId            String
  planId            String
  razorpayOrderId   String?        @unique
  quantity          Int            @default(1)
  unitPrice         Int            // Amount in paise per unit
  totalAmount       Int            // Total in paise (incl. all charges)
  currency          String         @default("INR")
  status            PurchaseStatus @default(CREATED)

  // Pricing breakdown (snapshot at purchase time)
  itemPrice         Int            @default(0)
  gstAmount         Int            @default(0)
  gatewayCharge     Int            @default(0)
  serviceFee        Int            @default(0)
  processingFee     Int            @default(0)
  platformCharge    Int            @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id])
  plan     Plan      @relation(fields: [planId], references: [id])
  payments Payment[]

  @@index([userId])
  @@index([planId])
  @@index([status])
  @@index([razorpayOrderId])
  @@map("purchases")
}

// ── Payments ─────────────────────────────────────────────

model Payment {
  id                String        @id @default(uuid())
  userId            String
  subscriptionId    String?
  purchaseId        String?
  razorpayPaymentId String?       @unique
  razorpayOrderId   String?
  razorpaySignature String?
  amount            Int // Amount in paise
  currency          String        @default("INR")
  status            PaymentStatus @default(CREATED)
  method            String? // card, upi, netbanking, etc.
  description       String?
  invoiceUrl        String?
  failureReason     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id])
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])
  purchase     Purchase?     @relation(fields: [purchaseId], references: [id])

  @@index([userId])
  @@index([subscriptionId])
  @@index([purchaseId])
  @@index([razorpayPaymentId])
  @@index([status])
  @@map("payments")
}

// ── Transactions ─────────────────────────────────────────

model Transaction {
  id       String  @id @default(uuid())
  userId   String
  title    String
  subtitle String?
  // NOTE: `amount` is stored as a Decimal in rupees (e.g. 1250.50), NOT in paise.
  // This intentionally differs from other money fields (Plan.oneTimePrice, Payment.amount, etc.)
  // which are Int paise. Transaction rows are display-only ledger entries written by
  // the webhook handler — changing them to paise would require a data migration.
  // TODO: migrate to Int paise in a future release for consistency across the schema.
  amount   Decimal @db.Decimal(12, 2)
  type     String // "debit" | "credit"
  status   String // "Success", "Pending", "Failed", "Settled"
  icon     String?
  category String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
  @@map("transactions")
}

// ── Linked Accounts ──────────────────────────────────────

model LinkedAccount {
  id          String  @id @default(uuid())
  userId      String
  bankName    String
  bankAbbr    String
  accountName String
  last4       String
  accountType String? // savings, current, corporate
  colorClass  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("linked_accounts")
}

// ── Email Campaigns ──────────────────────────────────────

model EmailCampaign {
  id             String         @id @default(uuid())
  name           String
  subject        String
  templateId     String?
  htmlContent    String?        @db.Text
  status         CampaignStatus @default(DRAFT)
  scheduledAt    DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  totalSent      Int            @default(0)
  totalDelivered Int            @default(0)
  totalOpened    Int            @default(0)
  totalClicked   Int            @default(0)
  totalBounced   Int            @default(0)
  totalFailed    Int            @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  template   EmailTemplate?   @relation(fields: [templateId], references: [id])
  recipients EmailRecipient[]

  @@index([status])
  @@map("email_campaigns")
}

model EmailRecipient {
  id             String              @id @default(uuid())
  campaignId     String
  userId         String
  email          String
  deliveryStatus EmailDeliveryStatus @default(PENDING)
  sentAt         DateTime?
  deliveredAt    DateTime?
  openedAt       DateTime?
  clickedAt      DateTime?
  bouncedAt      DateTime?
  failureReason  String?

  campaign EmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user     User          @relation(fields: [userId], references: [id])

  @@index([campaignId])
  @@index([userId])
  @@index([deliveryStatus])
  @@map("email_recipients")
}

model EmailTemplate {
  id          String    @id @default(uuid())
  name        String
  subject     String
  htmlContent String    @db.Text
  lastUsedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaigns EmailCampaign[]

  @@map("email_templates")
}

// ── Notifications ────────────────────────────────────────

model NotificationPreference {
  id                     String  @id @default(uuid())
  userId                 String  @unique
  monthlyStatements      Boolean @default(true)
  transactionAlerts      Boolean @default(true)
  promotionalOffers      Boolean @default(false)
  immediatePaymentAlerts Boolean @default(true)
  securityLogins         Boolean @default(true)
  billReminders          Boolean @default(true)
  systemAlerts           Boolean @default(true)
  securityNotifications  Boolean @default(true)
  userActivityReports    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

// ── Admin Settings ───────────────────────────────────────

model AdminSetting {
  id    String @id @default(uuid())
  key   String @unique
  value String @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admin_settings")
}

// ── Audit Log ────────────────────────────────────────────

model AuditLog {
  id        String  @id @default(uuid())
  userId    String?
  action    String
  entity    String // e.g., "Plan", "User", "Subscription"
  entityId  String?
  details   String? @db.Text // JSON string with change details
  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entity])
  @@index([createdAt])
  @@map("audit_logs")
}

// ── Products / Reviews ───────────────────────────────────

model Review {
  id        String       @id @default(uuid())
  rating    Int          // 1 to 5
  comment   String?
  userId    String
  planId    String
  status    ReviewStatus @default(APPROVED) // In a real app, maybe PENDING default
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@index([userId])
  @@index([status])
  @@map("reviews")
}

// ── Category Pricing ─────────────────────────────────────

model CategoryPricing {
  id                  String       @id @default(uuid())
  itemCategory        ItemCategory @unique

  // GST
  gstMode             PricingMode  @default(PERCENT)
  gstValue            Float        @default(0)

  // Payment gateway charges
  gatewayChargeMode   PricingMode  @default(PERCENT)
  gatewayChargeValue  Float        @default(0)

  // Service fee
  serviceFeeMode      PricingMode  @default(PERCENT)
  serviceFeeValue     Float        @default(0)

  // Processing fee
  processingFeeMode   PricingMode  @default(PERCENT)
  processingFeeValue  Float        @default(0)

  // Platform charges
  platformChargeMode  PricingMode  @default(PERCENT)
  platformChargeValue Float        @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("category_pricing")
}

// ══════════════════════════════════════════════════════════
// CAFT Academy — Course Platform Models
// ══════════════════════════════════════════════════════════

// ── Course ───────────────────────────────────────────────

model Course {
  id            String   @id @default(uuid())
  title         String
  slug          String   @unique
  description   String   @db.Text
  thumbnailUrl  String?
  trailerUrl    String?  // Public URL for trailer
  trailerS3Key  String?  // S3 key for trailer video
  price         Int      @default(0)     // in paise
  currency      String   @default("INR")
  isPublished   Boolean  @default(false)
  isFeatured    Boolean  @default(false)
  difficulty    String?  // beginner, intermediate, advanced
  language      String   @default("en")
  totalDuration Int      @default(0)     // total seconds across all videos
  totalVideos   Int      @default(0)

  // Link to existing Plan system for subscription gating
  planId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plan             Plan?              @relation(fields: [planId], references: [id])
  sections         CourseSection[]
  videos           Video[]
  enrollments      CourseEnrollment[]
  completions      CourseCompletion[]
  badges           Badge[]
  feedback         CourseFeedback[]
  videoAnalytics   VideoAnalytics[]
  coursePayments   CoursePayment[]

  @@index([isPublished])
  @@index([planId])
  @@index([slug])
  @@map("courses")
}

// ── Course Section ───────────────────────────────────────

model CourseSection {
  id         String @id @default(uuid())
  courseId   String
  title      String
  orderIndex Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  videos Video[]

  @@index([courseId])
  @@map("course_sections")
}

// ── Video ────────────────────────────────────────────────

model Video {
  id                     String  @id @default(uuid())
  sectionId              String
  courseId               String
  title                  String
  description            String? @db.Text
  s3Key                  String  // Full path in S3 bucket
  cloudfrontUrl          String? // Cached CloudFront/presigned URL
  durationSeconds        Int     @default(0)
  isPreview              Boolean @default(false)
  previewDurationSeconds Int     @default(60) // seconds allowed without subscription
  previewStartSeconds    Int     @default(0)  // seek to this position when preview starts
  previewEndSeconds      Int?                 // stop preview here; null = end of video
  orderIndex             Int     @default(0)
  isPublished            Boolean @default(true)
  thumbnailUrl           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  section       CourseSection   @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  course        Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  videoProgress VideoProgress[]
  videoEvents   VideoEvent[]
  analytics     VideoAnalytics?

  @@index([courseId])
  @@index([sectionId])
  @@index([isPreview])
  @@index([orderIndex])
  @@map("videos")
}

// ── Course Enrollment ────────────────────────────────────

model CourseEnrollment {
  id             String          @id @default(uuid())
  userId         String
  courseId        String
  subscriptionId String?         // Link to existing Subscription
  purchaseId     String?         // Link to one-time purchase
  accessType     CourseAccessType @default(FULL)
  isActive       Boolean         @default(true)
  enrolledAt     DateTime        @default(now())
  expiresAt      DateTime?

  user   User   @relation(fields: [userId], references: [id])
  course Course @relation(fields: [courseId], references: [id])

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@map("course_enrollments")
}

// ── Video Progress ───────────────────────────────────────

model VideoProgress {
  id                    String   @id @default(uuid())
  userId                String
  videoId               String
  courseId               String
  watchedSeconds        Int      @default(0)
  completionPercentage  Float    @default(0)
  isCompleted           Boolean  @default(false)
  lastWatchedAt         DateTime @default(now())
  resumePositionSeconds Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id])
  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId])
  @@index([userId, courseId])
  @@index([lastWatchedAt])
  @@map("video_progress")
}

// ── Video Event (Behavioral Tracking) ────────────────────

model VideoEvent {
  id              String         @id @default(uuid())
  userId          String
  videoId         String
  eventType       VideoEventType
  eventTimestamp  DateTime       @default(now())
  positionSeconds Int            @default(0)
  metadataJson    Json?          // Extra data (from_pos, to_pos, etc.)

  user  User  @relation(fields: [userId], references: [id])
  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([videoId])
  @@index([eventType])
  @@index([eventTimestamp])
  @@map("video_events")
}

// ── Course Completion ────────────────────────────────────

model CourseCompletion {
  id             String   @id @default(uuid())
  userId         String
  courseId        String
  completedAt    DateTime @default(now())
  certificateUrl String?  // S3 URL of generated PDF
  certificateId  String?  @unique // Unique cert verification ID
  badgeAwarded   Boolean  @default(false)

  user   User   @relation(fields: [userId], references: [id])
  course Course @relation(fields: [courseId], references: [id])

  @@unique([userId, courseId])
  @@index([userId])
  @@map("course_completions")
}

// ── Course Payment (Direct enrollment, no Plan required) ─

model CoursePayment {
  id                  String  @id @default(uuid())
  userId              String
  courseId            String
  razorpayOrderId     String? @unique
  razorpayPaymentId   String?
  amount              Int     // in paise
  currency            String  @default("INR")
  status              String  @default("CREATED") // CREATED | PAID | FAILED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id])
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([courseId])
  @@map("course_payments")
}

// ── Badge ────────────────────────────────────────────────

model Badge {
  id        String    @id @default(uuid())
  userId    String
  courseId  String?
  badgeType BadgeType
  awardedAt DateTime  @default(now())

  user   User    @relation(fields: [userId], references: [id])
  course Course? @relation(fields: [courseId], references: [id])

  @@index([userId])
  @@map("badges")
}

// ── Video Analytics (Aggregated) ─────────────────────────

model VideoAnalytics {
  id               String @id @default(uuid())
  videoId          String @unique
  courseId         String
  totalViews       Int    @default(0)
  uniqueViewers    Int    @default(0)
  avgWatchDuration Float  @default(0) // in seconds
  completionRate   Float  @default(0) // 0.0 to 100.0

  updatedAt DateTime @updatedAt

  video  Video  @relation(fields: [videoId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id])

  @@index([courseId])
  @@map("video_analytics")
}

// ── Course Feedback ──────────────────────────────────────

model CourseFeedback {
  id          String   @id @default(uuid())
  userId      String
  courseId    String
  rating      Int      // 1 to 5
  reviewText  String?  @db.Text
  submittedAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  course Course @relation(fields: [courseId], references: [id])

  @@unique([userId, courseId])
  @@index([courseId])
  @@index([rating])
  @@map("course_feedback")
}
