// ─────────────────────────────────────────────────────────
// CAFT Financial — Prisma Schema
// ─────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ────────────────────────────────────────────────

enum Role {
  USER
  ADMIN
}

enum SubscriptionStatus {
  CREATED
  AUTHENTICATED
  ACTIVE
  PENDING
  HALTED
  CANCELLED
  COMPLETED
  EXPIRED
}

enum PaymentStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  REFUNDED
  FAILED
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  PAUSED
  COMPLETED
  FAILED
}

enum EmailDeliveryStatus {
  PENDING
  SENT
  DELIVERED
  BOUNCED
  COMPLAINED
  FAILED
}

// ── User ─────────────────────────────────────────────────

model User {
  id                String    @id @default(uuid())
  email             String    @unique
  name              String
  phone             String?
  avatarUrl         String?
  role              Role      @default(USER)
  passwordHash      String?   // Only for admin users
  isActive          Boolean   @default(true)
  isEmailVerified   Boolean   @default(false)
  kycVerified       Boolean   @default(false)
  twoFactorEnabled  Boolean   @default(false)
  biometricEnabled  Boolean   @default(false)
  isSuperAdmin      Boolean   @default(false)  // Only true for seed-created admin
  referralCode      String?   @unique
  referredById      String?

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  lastLoginAt       DateTime?

  // Relations
  referredBy          User?                  @relation("UserReferrals", fields: [referredById], references: [id])
  referrals           User[]                 @relation("UserReferrals")
  otpTokens           OtpToken[]
  refreshTokens       RefreshToken[]
  subscriptions       Subscription[]
  payments            Payment[]
  transactions        Transaction[]
  linkedAccounts      LinkedAccount[]
  notificationPrefs   NotificationPreference?
  campaignRecipients  EmailRecipient[]
  auditLogs           AuditLog[]

  @@index([email])
  @@index([role])
  @@index([isActive])
  @@map("users")
}

// ── Auth ─────────────────────────────────────────────────

model OtpToken {
  id        String   @id @default(uuid())
  userId    String
  code      String
  attempts  Int      @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("otp_tokens")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

// ── Subscription Plans ───────────────────────────────────

model Plan {
  id                      String   @id @default(uuid())
  name                    String
  slug                    String   @unique
  description             String
  priceMonthly            Int      // Amount in paise (smallest currency unit)
  priceYearly             Int      // Amount in paise
  currency                String   @default("INR")
  razorpayPlanIdMonthly   String?  // Razorpay plan ID for monthly billing
  razorpayPlanIdYearly    String?  // Razorpay plan ID for yearly billing
  isPopular               Boolean  @default(false)
  isActive                Boolean  @default(true)
  sortOrder               Int      @default(0)
  trialPeriodDays         Int?

  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  // Relations
  features      PlanFeature[]
  subscriptions Subscription[]

  @@index([isActive])
  @@index([slug])
  @@map("plans")
}

model PlanFeature {
  id       String  @id @default(uuid())
  planId   String
  name     String
  included Boolean @default(true)
  value    String? // e.g., "10", "Unlimited", "Monthly"

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@map("plan_features")
}

// ── Subscriptions ────────────────────────────────────────

model Subscription {
  id                      String             @id @default(uuid())
  userId                  String
  planId                  String
  razorpaySubscriptionId  String?            @unique
  razorpayCustomerId      String?
  status                  SubscriptionStatus @default(CREATED)
  billingCycle            BillingCycle       @default(MONTHLY)
  currentPeriodStart      DateTime?
  currentPeriodEnd        DateTime?
  cancelledAt             DateTime?
  cancelReason            String?

  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  user     User      @relation(fields: [userId], references: [id])
  plan     Plan      @relation(fields: [planId], references: [id])
  payments Payment[]

  @@index([userId])
  @@index([planId])
  @@index([status])
  @@index([razorpaySubscriptionId])
  @@map("subscriptions")
}

// ── Payments ─────────────────────────────────────────────

model Payment {
  id                 String        @id @default(uuid())
  userId             String
  subscriptionId     String?
  razorpayPaymentId  String?       @unique
  razorpayOrderId    String?
  razorpaySignature  String?
  amount             Int           // Amount in paise
  currency           String        @default("INR")
  status             PaymentStatus @default(CREATED)
  method             String?       // card, upi, netbanking, etc.
  description        String?
  invoiceUrl         String?
  failureReason      String?

  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  user         User          @relation(fields: [userId], references: [id])
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])

  @@index([userId])
  @@index([subscriptionId])
  @@index([razorpayPaymentId])
  @@index([status])
  @@map("payments")
}

// ── Transactions ─────────────────────────────────────────

model Transaction {
  id       String   @id @default(uuid())
  userId   String
  title    String
  subtitle String?
  amount   Decimal  @db.Decimal(12, 2)
  type     String   // "debit" | "credit"
  status   String   // "Success", "Pending", "Failed", "Settled"
  icon     String?
  category String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
  @@map("transactions")
}

// ── Linked Accounts ──────────────────────────────────────

model LinkedAccount {
  id            String  @id @default(uuid())
  userId        String
  bankName      String
  bankAbbr      String
  accountName   String
  last4         String
  accountType   String? // savings, current, corporate
  colorClass    String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("linked_accounts")
}

// ── Email Campaigns ──────────────────────────────────────

model EmailCampaign {
  id            String         @id @default(uuid())
  name          String
  subject       String
  templateId    String?
  htmlContent   String?        @db.Text
  status        CampaignStatus @default(DRAFT)
  scheduledAt   DateTime?
  startedAt     DateTime?
  completedAt   DateTime?
  totalSent     Int            @default(0)
  totalDelivered Int           @default(0)
  totalOpened   Int            @default(0)
  totalClicked  Int            @default(0)
  totalBounced  Int            @default(0)
  totalFailed   Int            @default(0)

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  template   EmailTemplate?  @relation(fields: [templateId], references: [id])
  recipients EmailRecipient[]

  @@index([status])
  @@map("email_campaigns")
}

model EmailRecipient {
  id              String              @id @default(uuid())
  campaignId      String
  userId          String
  email           String
  deliveryStatus  EmailDeliveryStatus @default(PENDING)
  sentAt          DateTime?
  deliveredAt     DateTime?
  openedAt        DateTime?
  clickedAt       DateTime?
  bouncedAt       DateTime?
  failureReason   String?

  campaign EmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user     User          @relation(fields: [userId], references: [id])

  @@index([campaignId])
  @@index([userId])
  @@index([deliveryStatus])
  @@map("email_recipients")
}

model EmailTemplate {
  id          String   @id @default(uuid())
  name        String
  subject     String
  htmlContent String   @db.Text
  lastUsedAt  DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  campaigns EmailCampaign[]

  @@map("email_templates")
}

// ── Notifications ────────────────────────────────────────

model NotificationPreference {
  id                      String  @id @default(uuid())
  userId                  String  @unique
  monthlyStatements       Boolean @default(true)
  transactionAlerts       Boolean @default(true)
  promotionalOffers       Boolean @default(false)
  immediatePaymentAlerts  Boolean @default(true)
  securityLogins          Boolean @default(true)
  billReminders           Boolean @default(true)
  systemAlerts            Boolean @default(true)
  securityNotifications   Boolean @default(true)
  userActivityReports     Boolean @default(false)

  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

// ── Admin Settings ───────────────────────────────────────

model AdminSetting {
  id    String @id @default(uuid())
  key   String @unique
  value String @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admin_settings")
}

// ── Audit Log ────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  entity     String   // e.g., "Plan", "User", "Subscription"
  entityId   String?
  details    String?  @db.Text // JSON string with change details
  ipAddress  String?
  userAgent  String?

  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entity])
  @@index([createdAt])
  @@map("audit_logs")
}
